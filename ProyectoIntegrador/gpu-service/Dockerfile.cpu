FROM python:3.12-slim AS native-build
RUN apt-get update && apt-get install -y --no-install-recommends g++ libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY src/ ./src/
RUN mkdir -p /out && g++ -O3 -std=c++17 -fopenmp -fPIC -shared \
    src/normalizer_cpu.cpp -o /out/libnormalizer.so

FROM python:3.12-slim
ENV PYTHONUNBUFFERED=1 NORMALIZER_LIBRARY=/opt/normalizer/libnormalizer.so PORT=8080
RUN apt-get update && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY --from=native-build /out/libnormalizer.so /opt/normalizer/libnormalizer.so
COPY app.py .
CMD ["sh", "-c", "uvicorn app:app --host 0.0.0.0 --port ${PORT}"]
